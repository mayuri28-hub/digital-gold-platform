
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "buildCommand": "npm run build",
      "entrypoint": "src/app.ts"
    },
    "admin": {
      "root": "admin-panel",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/admin/assets/:path*",
          "destination": "/assets/:path*"
        },
        {
          "source": "/admin/favicon.svg",
          "destination": "/favicon.svg"
        },
        {
          "source": "/admin",
          "destination": "/index.html"
        },
        {
          "source": "/admin/:path*",
          "destination": "/index.html"
        }
      ]
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
